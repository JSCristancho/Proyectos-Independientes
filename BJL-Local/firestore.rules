rules_version = '2';

// =====================================================
// REGLAS DE SEGURIDAD - BJL Bordados
// Cambia SOLO el correo de la dueña (una vez) y publica estas reglas en
// Firebase > Firestore Database > Reglas.
//
// Quien puede entrar:
//   - la dueña (correo de abajo), o
//   - quien la dueña haya agregado en la app (Ajustes > Usuarios) y este activo.
// Todos deben tener el correo confirmado.
// =====================================================
service cloud.firestore {
  match /databases/{database}/documents {

    function verificada() {
      return request.auth != null && request.auth.token.email_verified == true;
    }
    function correo() {
      return request.auth.token.email.lower();
    }
    function esDuena() {
      return verificada() && correo() == "PON-AQUI-EL-CORREO-DE-LA-DUENA@gmail.com";
    }
    function autorizado() {
      return esDuena()
        || (verificada()
            && get(/databases/$(database)/documents/usuarios/$(correo())).data.activo == true);
    }

    // Lista de personas autorizadas: solo la dueña la modifica.
    // Cada persona puede leer unicamente su propio registro.
    match /usuarios/{id} {
      allow read: if esDuena() || (verificada() && id == correo());
      allow write: if esDuena();
    }

    match /ordenes/{id}    { allow read, write: if autorizado(); }
    match /productos/{id}  { allow read, write: if autorizado(); }
    match /contadores/{id} { allow read, write: if autorizado(); }
    match /config/{id}     { allow read, write: if autorizado(); }

    // Todo lo demas queda prohibido.
  }
}
